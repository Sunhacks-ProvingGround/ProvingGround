{
  "name": "provingground",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "pnpm --filter @pg/core db:migrate",
    "db:load": "pnpm --filter @pg/core db:load",
    "db:check": "pnpm --filter @pg/core db:check",
    "backtest": "pnpm --filter @pg/core backtest",
    "runs:verify": "pnpm --filter @pg/core runs:verify",
    "agent:preview": "pnpm --filter @pg/core agent:preview",
    "report": "pnpm --filter @pg/core report",
    "gap": "pnpm --filter @pg/core gap",
    "typecheck": "pnpm -r typecheck"
  }
}
